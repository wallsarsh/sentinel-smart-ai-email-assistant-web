# Copy to deploy/.env. Every value here must be replaced; nothing in this file is a working secret.
NODE_ENV=production
# The public https address users reach (behind your TLS proxy).
BASE_URL=https://sentinel.example.org
POSTGRES_PASSWORD=
# Use the same password as above, or your managed database's URL (add ?sslmode=require when needed).
DATABASE_URL=postgres://sentinel:CHANGE_ME@postgres:5432/sentinel
# openssl rand -base64 48
SESSION_SECRET=
# Exactly 32 random bytes, base64: openssl rand -base64 32. Keep it in your secret manager; losing it loses stored provider tokens.
KEK_BASE64=
# Key rotation (docs/runbook.md): bump KEK_VERSION when KEK_BASE64 changes and list older keys as version:base64,version:base64.
KEK_VERSION=1
KEK_PREVIOUS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_AUTHORITY=https://login.microsoftonline.com/common
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
# Mail the service itself sends (password reset).
SYSTEM_SMTP_URL=smtp://user:pass@smtp.example.org:587
SYSTEM_MAIL_FROM=Sentinel <no-reply@example.org>
# Optional
METRICS_TOKEN=
ERROR_REPORT_URL=
BUILD_ID=
