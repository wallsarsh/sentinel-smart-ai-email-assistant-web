# Copy to .env. Every value here is a development placeholder; production
# values come from the secret manager. Secrets must never be committed.

NODE_ENV=development
BASE_URL=http://localhost:3000

# Postgres (matches docker-compose.dev.yml)
DATABASE_URL=postgres://sentinel:sentinel-dev-only@localhost:5432/sentinel

# 32+ random characters; signs session cookies. Generate: openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-0123456789abcdef0123456789

# Key-encryption key: exactly 32 random bytes, base64. Generate: openssl rand -base64 32
KEK_BASE64=ZGV2LW9ubHkta2VrLTMyLWJ5dGVzLTAxMjM0NTY3ODk=

# Google web OAuth client (T009)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra app (T010)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_AUTHORITY=https://login.microsoftonline.com/common

# Web push (T122). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.test

# Transactional mail the service sends (password reset). Dev: Mailpit.
SYSTEM_SMTP_URL=smtp://localhost:1025
SYSTEM_MAIL_FROM="Sentinel <no-reply@localhost>"
