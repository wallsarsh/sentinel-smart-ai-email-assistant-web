{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sentinel AI Email Assistant",
  "version": "0.2.0",
  "identifier": "in.simplifyit.sentinel.email.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Standalone Sentinel AI Email Assistant",
    "resources": { "runtime/": "runtime" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
