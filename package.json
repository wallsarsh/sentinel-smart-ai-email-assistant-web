{
  "name": "sentinel-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run send-gate",
    "send-gate": "node tools/send-gate-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@node-rs/argon2": "^2.2.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^29.1.1",
    "nodemailer": "^10.2.1",
    "nuxt": "^4.5.2",
    "nuxt-security": "^2.5.1",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "pino": "^10.4.0",
    "undici": "^8.12.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
