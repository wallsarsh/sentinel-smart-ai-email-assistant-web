{
  "name": "sentinel-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run send-gate",
    "send-gate": "node tools/send-gate-check.mjs",
    "i18n:pseudo": "node tools/pseudo.mjs",
    "prompts:sync": "node tools/sync-prompts.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "worker": "tsx worker/index.ts",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "eval": "tsx tools/eval/run.ts",
    "budget": "node tools/bundle-budget.mjs",
    "secrets": "node tools/secrets-scan.mjs",
    "kek:rotate": "tsx server/db/rotate-kek.ts",
    "ext:build": "node tools/build-extension.mjs",
    "ext:xpi": "node installer/package-xpi.mjs",
    "install:thunderbird": "node installer/install.mjs",
    "demo:mail": "node tools/generate-demo-mail.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@node-rs/argon2": "^2.2.2",
    "ajv": "^8.20.0",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "imapflow": "^1.7.8",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^29.1.1",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "undici": "^8.12.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^1.0.3",
    "@types/imapflow": "^1.0.23",
    "@types/jsdom": "^30.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.5.2",
    "nuxt-security": "^2.5.1",
    "pinia": "^4.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13",
    "yaml": "^2.9.1"
  }
}
