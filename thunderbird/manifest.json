{
  "manifest_version": 3,
  "name": "Sentinel AI (spike)",
  "version": "0.1.0",
  "description": "Summarize the open message and draft a reply with your own AI provider. Never sends mail.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sentinel-spike@example.invalid",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "accountsRead",
    "alarms",
    "clipboardWrite",
    "compose",
    "compose.save",
    "downloads",
    "menus",
    "messagesRead",
    "messagesTags",
    "messagesTagsList",
    "messagesUpdate",
    "notifications",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
	"http://localhost:1234/v1",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "message_display_action": {
    "default_title": "Sentinel AI",
    "default_popup": "dist/popup.html"
  },
  "compose_action": {
    "default_title": "Sentinel AI — draft this reply",
    "default_label": "Sentinel",
    "default_area": "maintoolbar",
    "default_popup": "dist/compose.html"
  },
  "options_ui": {
    "page": "dist/options.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "sentinelCalendar": {
      "schema": "experiments/sentinel-calendar/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/sentinel-calendar/implementation.js",
        "paths": [["sentinelCalendar"]]
      }
    }
  },
  "background": {
    "scripts": [
      "dist/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Sentinel daily brief",
    "default_popup": "dist/brief.html"
  }
}